{
  "name": "ui-assert",
  "version": "0.1.0",
  "description": "Run a page in a real browser and get a compact, machine-readable verdict on tokens, layout and accessibility.",
  "type": "module",
  "bin": {
    "ui-assert": "dist/cli.js",
    "ui-assert-mcp": "dist/mcp.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Aakash Pai",
  "keywords": [
    "playwright",
    "accessibility",
    "design-tokens",
    "css",
    "layout",
    "axe",
    "cli",
    "mcp",
    "ai-agents",
    "claude-code",
    "design-system"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axe-core": "^4.10.3",
    "playwright": "^1.56.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aakashpai/ui-assert.git"
  },
  "homepage": "https://github.com/Aakashpai/ui-assert#readme",
  "bugs": {
    "url": "https://github.com/Aakashpai/ui-assert/issues"
  }
}
